# GitHub Personal Access Token
# Create one at https://github.com/settings/tokens
# Required scopes: public_repo
GITHUB_TOKEN=ghp_your_token_here

# PostgreSQL Database Credentials (for parallel worker mode)
# These are used when database.type=postgresql in config.yaml
POSTGRES_USER=ci_audit
POSTGRES_PASSWORD=ci_audit_secure_password_123
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=ci_audit

# Worker ID (optional, defaults to hostname)
# WORKER_ID=worker1
